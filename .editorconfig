# Mise en forme commune à tous les dépôts Lorderis / Foody / Impera / BeeFluid.
# Fichier identique partout : ne le modifier qu'en le modifiant partout.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Deux espaces finales y sont un saut de ligne voulu.
[*.md]
trim_trailing_whitespace = false

# Les analyseurs Windows lisent ces scripts en CRLF.
[*.{bat,cmd,ps1,nsh}]
end_of_line = crlf

[*.{swift,kt,kts,java,cs,gradle,py,rs}]
indent_size = 4

[{Makefile,*.mk,go.mod,*.go}]
indent_style = tab
